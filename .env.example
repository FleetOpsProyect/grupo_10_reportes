# Copiar a .env (no se sube al repositorio). En la EC2 este archivo vive en ~/reporting/.env

SERVER_PORT=3010

# Base de lectura
DATABASE_URL=jdbc:postgresql://postgres:5432/reporting
DATABASE_USER=reporting
DATABASE_PASSWORD=cambiar-esto

# Resiliencia
REPORTES_TIMEOUT_MS=3000
REPORTES_CB_FALLOS=5
REPORTES_CB_ESPERA_S=30
REPORTES_CACHE_TTL_S=0

# Fuentes HTTP (URLs internas de cada microservicio)
FUENTE_VEHICULOS_URL=http://vehiculos-api:8080
FUENTE_ASIGNACIONES_URL=http://asignaciones-api:8080
FUENTE_INCIDENTES_URL=http://incidentes-api:8080
FUENTE_MANTENIMIENTO_URL=http://mantenimiento-api:8080
FUENTE_COMBUSTIBLE_URL=http://combustible-api:8080
FUENTE_TELEMETRIA_URL=http://telemetria-api:8080
FUENTE_NOTIFICACIONES_URL=http://notificaciones-api:8080

# Eventos (SNS -> SQS). En AWS las credenciales salen del rol IAM de la EC2.
SQS_ENABLED=false
SQS_QUEUE_URL=
AWS_REGION=us-east-1
# Solo en local con LocalStack:
SQS_ENDPOINT=
