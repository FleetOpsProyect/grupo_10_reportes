# Copiar a .env (no se sube al repositorio).
#   - Local: .env en la raíz del proyecto; lo leen tanto el IDE / ./mvnw spring-boot:run como docker compose.
#   - EC2:   no se crea a mano. El deploy genera ~/reporting/.env con los secretos y variables del
#            environment "production" de GitHub (rama "production" de Neon). Ver README.

SERVER_PORT=3010

# Base de lectura en Neon (PostgreSQL serverless).
# En Neon: Dashboard -> Connect -> elegir la rama (develop o production), activar "Connection pooling"
# y copiar la cadena en formato JDBC (Java). Quitar de la URL los parámetros user= y password=
# y ponerlos en las dos variables de abajo: si van en la URL, la clave aparece en los logs.
DATABASE_URL=jdbc:postgresql://ep-xxxxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=cambiar-esto

# Resiliencia
REPORTES_TIMEOUT_MS=3000
REPORTES_CB_FALLOS=5
REPORTES_CB_ESPERA_S=30
REPORTES_CACHE_TTL_S=0

# Fuentes HTTP (URLs internas de cada microservicio)
FUENTE_VEHICULOS_URL=http://vehiculos-api:8080
FUENTE_ASIGNACIONES_URL=http://asignaciones-api:8080
FUENTE_INCIDENTES_URL=http://incidentes-api:8080
FUENTE_MANTENIMIENTO_URL=http://mantenimiento-api:8080
FUENTE_COMBUSTIBLE_URL=http://combustible-api:8080
FUENTE_TELEMETRIA_URL=http://telemetria-api:8080
FUENTE_NOTIFICACIONES_URL=http://notificaciones-api:8080

# Eventos (SNS -> SQS). En AWS las credenciales salen del rol IAM de la EC2.
SQS_ENABLED=false
SQS_QUEUE_URL=
AWS_REGION=us-east-1
# Solo en local con LocalStack:
SQS_ENDPOINT=
